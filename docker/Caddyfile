# Auto Clipper - Caddyfile (Auto HTTPS)
# Replace {$DOMAIN} with your domain via env

{
	email {$EMAIL}
}

{$DOMAIN} {
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}
	}
	encode gzip
	log {
		output stdout
	}
}

# Fallback for IP access
:80 {
	@isApp {
		host {$DOMAIN}
	}
	handle @isApp {
		reverse_proxy app:3000
	}
	handle {
		reverse_proxy app:3000
	}
}
